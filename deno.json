{
  "name": "@shado/elipsis",
  "version": "1.1.1",
  "description": "TypeScript Tor client and hidden-service toolkit built on standard Node/Deno runtime APIs for Deno, Node.js, and Edge Functions.",
  "license": "MIT",
  "nodeModulesDir": "auto",
  "exports": {
    ".": "./mod.ts",
    "./edge": "./src/edge/middleware.ts",
    "./socks": "./src/client/socks5.ts",
    "./http": "./src/client/http_proxy.ts",
    "./hs": "./src/hs/orchestrator.ts",
    "./crypto": "./src/crypto/ntor.ts"
  },
  "compilerOptions": {
    "strict": true,
    "lib": ["deno.window", "deno.ns", "esnext"]
  },
  "tasks": {
    "test": "deno test --allow-all test/",
    "trial": "deno run --allow-all assets/api_trial_suite.ts",
    "examples": "deno run --allow-all examples/all_apis_comprehensive.ts"
  }
}
